@startuml
title Redis Commander TUI - Запуск и загрузка профилей

actor User as "Пользователь"
participant "main()" as Main
participant "argparse" as Argparse
participant "RedisCommanderUI" as UI
participant "load_profiles()" as Loader
participant "Обычный JSON" as Json
participant "Зашифрованный конфиг" as Enc
participant "Vault" as Vault
participant "_parse_profiles()" as Parse
participant "validate_profiles()" as Validate
participant "Список профилей" as Selector
participant "connect_to_profile()" as Connect
participant "Основной интерфейс" as MainUI
participant "Окно диагностики" as Diagnostics

"Пользователь" -> Main: Запуск приложения
Main -> Argparse: Разбор аргументов CLI
Argparse --> Main: args
Main -> UI: RedisCommanderUI(args)
UI -> Loader: load_profiles()

alt передан --vault-url
  Loader -> Vault: _load_from_vault()
  Vault --> Loader: profiles_data
else передан --encrypted-config
  Loader -> Enc: _load_encrypted_config()
  Enc --> Loader: profiles_data
else режим по умолчанию
  Loader -> Json: _load_plaintext_config()
  Json --> Loader: profiles_data
end

Loader -> Parse: _parse_profiles(profiles_data)
Parse --> UI: profiles
UI -> Validate: validate_profiles()
Validate --> UI: validated profiles
UI -> Selector: Показать профили из конфигурации
"Пользователь" -> Selector: Выбор профиля + Enter
Selector -> Connect: connect_to_profile(profile)

alt подключение успешно
  Connect -> MainUI: Показать DB и ключи
  "Пользователь" -> MainUI: Disconnect
  MainUI -> Selector: Закрыть соединение и вернуться
else ошибка подключения
  Connect -> Diagnostics: Безопасная расширенная диагностика
  Diagnostics -> Selector: Back
end

@enduml

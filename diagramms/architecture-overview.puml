@startuml
title Redis Commander TUI - Architecture Overview

skinparam shadowing false
skinparam componentStyle rectangle

package "CLI Entry" {
  [main()]
  [argparse]
}

package "Application Core" {
  [RedisCommanderUI]
  [ConnectionProfile]
  [RedisConnection]
}

package "UI Components" {
  [Profile Selector]
  [Connection Diagnostics]
  [KeyListView]
  [KeyListItem]
  [AddKeyDialog]
  [CommandPromptWrapper]
  [ScrollBar]
}

package "Background Loading" {
  [Cancellable SCAN Workers]
  [TYPE Pipeline Batches]
}

package "Profile Sources" {
  [Plain JSON]
  [Encrypted Config]
  [HashiCorp Vault]
}

package "External Services" {
  [Redis Standalone]
  [Redis Sentinel]
  [Redis Replicas]
  [Redis Cluster]
  [Filesystem]
  [Audit Log]
}

[main()] --> [argparse]
[argparse] --> [RedisCommanderUI]

[RedisCommanderUI] --> [ConnectionProfile]
[RedisCommanderUI] --> [RedisConnection]
[RedisCommanderUI] --> [Profile Selector]
[RedisCommanderUI] --> [Connection Diagnostics]
[RedisCommanderUI] --> [KeyListView]
[RedisCommanderUI] --> [AddKeyDialog]
[RedisCommanderUI] --> [CommandPromptWrapper]
[RedisCommanderUI] --> [ScrollBar]

[KeyListView] --> [KeyListItem]
[AddKeyDialog] --> [RedisConnection]

[RedisCommanderUI] --> [Plain JSON]
[RedisCommanderUI] --> [Encrypted Config]
[RedisCommanderUI] --> [HashiCorp Vault]

[Plain JSON] --> [Filesystem]
[Encrypted Config] --> [Filesystem]
[HashiCorp Vault] --> [Filesystem]

[RedisConnection] --> [Redis Standalone]
[RedisConnection] --> [Redis Sentinel] : discover topology
[RedisConnection] --> [Redis Replicas] : optional reads
[RedisConnection] --> [Redis Cluster]
[RedisCommanderUI] --> [Cancellable SCAN Workers]
[Cancellable SCAN Workers] --> [TYPE Pipeline Batches]
[RedisCommanderUI] --> [Audit Log]
[Audit Log] --> [Filesystem]

@enduml
